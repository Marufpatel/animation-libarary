{
  "name": "@marufpatel/animation-library",
  "version": "0.1.0",
  "description": "Reusable frame-driven React/SVG animation components and original cricket preset",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {".": {"types": "./dist/index.d.ts", "import": "./dist/index.js"}},
  "files": ["dist", "public/fonts", "README.md", "THIRD-PARTY-NOTICES.md"],
  "scripts": {
    "assets": "bun scripts/assets.ts",
    "build": "bun run assets && bun build src/index.ts --outdir dist --target browser --external react --external react/jsx-runtime && tsc --emitDeclarationOnly",
    "prepare": "bun run build",
    "test": "bun test tests",
    "typecheck": "bun run assets && tsc --noEmit"
  },
  "peerDependencies": {"react": ">=19"},
  "devDependencies": {"react": "19.1.0", "react-dom": "19.1.0", "@types/react": "^19.1.17", "@types/react-dom": "^19.1.11", "@types/bun": "^1.3.14", "typescript": "^5.9.3"},
  "repository": {"type": "git", "url": "https://github.com/Marufpatel/animation-libarary.git"},
  "license": "MIT",
  "private": false
}
